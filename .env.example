# Copy to .env (which git ignores) and fill in. The token comes from the Cloudflare dashboard:
# Zero Trust > Networks > Tunnels > your tunnel > the "docker run" command shows it after --token.
TUNNEL_TOKEN=

# How players can reach you: an email or web address. It is shown on the terms of use and privacy pages. Leave empty and those pages
# say "ask the person who gave you the address of this game".
CONTACT_ADDRESS=

# Only if you turn on the Cloudflare Turnstile human check (see DEPLOYMENT.md):
# TURNSTILE_SECRET_KEY=
